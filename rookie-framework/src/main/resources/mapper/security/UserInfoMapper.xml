<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.framework.security.mapper.UserInfoMapper">
    
    <select id="selectUserByUsername" parameterType="string" resultType="com.rookie.framework.security.pojo.UserInfo">
        select * from sys_user where username=#{username}
    </select>

    <select id="selectRoleIdByUserId" parameterType="long" resultType="Integer">
        select role_id from sys_user_role where user_id=#{userId}
    </select>
    
    <select id="selectMenuIdByRoleId" parameterType="integer" resultType="integer">
        select menu_id from sys_role_menu where role_id in
        <foreach collection="roles" open="(" close=")" separator=", " item="id">
            #{id}
        </foreach>
    </select>

    <select id="getPermKeyById" parameterType="integer" resultType="string">
        select perm_key from sys_menu where menu_id in
        <foreach collection="menus" open="(" close=")" separator=", " item="id">
            #{id}
        </foreach>
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.framework.security.mapper.UserInfoMapper">
    
    <select id="selectUserByUsername" parameterType="string" resultType="com.rookie.framework.security.pojo.UserInfo">
        select * from sys_user where username=#{username}
    </select>

    <select id="selectRoleByUserId" parameterType="long" resultType="com.rookie.common.pojo.entity.SysRole">
        select * from sys_role r
        join sys_user_role ur on ur.role_id = r.role_id
        where ur.user_id=#{userId}
    </select>
    
    <select id="selectMenuIdByRoleId" parameterType="integer" resultType="integer">
        select menu_id from sys_role_menu where role_id in
        <foreach collection="roles" open="(" close=")" separator=", " item="id">
            #{id}
        </foreach>
    </select>

    <select id="getPermKeyById" parameterType="integer" resultType="string">
        select perm_key from sys_menu where menu_id in
        <foreach collection="menus" open="(" close=")" separator=", " item="id">
            #{id}
        </foreach>
    </select>

    <!-- 查询全部按钮型权限标识（仅启用、未删除的按钮权限），供 admin 直通兜底加载 -->
    <select id="selectAllPermKey" resultType="string">
        select perm_key from sys_menu
        where perm_key is not null and perm_key != ''
          and perm_key like 'system:%:%'
          and status = 1 and `delete` = 0
    </select>
</mapper>
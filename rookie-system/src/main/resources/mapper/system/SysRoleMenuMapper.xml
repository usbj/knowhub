<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.system.mapper.SysRoleMenuMapper">

    <resultMap id="sysRoleMenuMap" type="com.rookie.system.pojo.SysRoleMenu">
        <result property="roleId" column="role_id"/>
        <result property="menuId" column="menu_id"/>
    </resultMap>

    <delete id="deleteSyeRoleMenu" parameterType="long">
        delete from sys_role_menu where role_id=#{roleId}
    </delete>

    <insert id="insertSysRoleMenu" parameterType="com.rookie.system.pojo.SysRoleMenu">
        insert into sys_role_menu(role_id, menu_id)
        values
            <foreach collection="list" item="item" separator="," >
                (#{item.roleId},#{item.menuId})
            </foreach>
    </insert>

    <select id="getRoleMenuByRoleIds" resultMap="sysRoleMenuMap">
        select role_id, menu_id from sys_role_menu
        where role_id in
        <foreach collection="list" item="roleId" open="(" close=")" separator=",">
            #{roleId}
        </foreach>
    </select>

</mapper>

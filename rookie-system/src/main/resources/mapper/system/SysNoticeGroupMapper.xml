<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rookie.system.mapper.SysNoticeGroupMapper">

    <resultMap id="SysNoticeGroupResultMap" type="com.rookie.common.pojo.entity.SysNoticeGroup">
        <id property="groupId" column="group_id"/>
        <result property="groupName" column="group_name"/>
        <result property="groupCode" column="group_code"/>
        <result property="groupDesc" column="group_desc"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <insert id="addSysNoticeGroup" parameterType="com.rookie.common.pojo.entity.SysNoticeGroup" useGeneratedKeys="true" keyProperty="groupId">
        insert into sys_notice_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupName!=null">group_name,</if>
            <if test="groupCode!=null">group_code,</if>
            <if test="groupDesc!=null">group_desc,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="groupName!=null">#{groupName},</if>
            <if test="groupCode!=null">#{groupCode},</if>
            <if test="groupDesc!=null">#{groupDesc},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <update id="editSysNoticeGroupInfo" parameterType="com.rookie.common.pojo.entity.SysNoticeGroup">
        update sys_notice_group
        <set>
            <if test="groupName!=null and groupName!=''">group_name = #{groupName},</if>
            <if test="groupCode!=null and groupCode!=''">group_code = #{groupCode},</if>
            <if test="groupDesc!=null and groupDesc!=''">group_desc = #{groupDesc},</if>
            <if test="status!=null">status = #{status},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where group_id = #{groupId}
    </update>

    <delete id="deleteSysNoticeGroupById" parameterType="long">
        delete from sys_notice_group where group_id = #{groupId}
    </delete>

    <select id="getSysNoticeGroupInfoById" parameterType="long" resultMap="SysNoticeGroupResultMap">
        select * from sys_notice_group where group_id = #{groupId}
    </select>

    <select id="quarrySysNoticeGroup" parameterType="com.rookie.system.pojo.quarry.NoticeGroupQuarry" resultMap="SysNoticeGroupResultMap">
        select * from sys_notice_group
        <where>
            <if test="groupName!=null and groupName!=''">and group_name like concat('%',#{groupName},'%')</if>
            <if test="groupCode!=null and groupCode!=''">and group_code = #{groupCode}</if>
            <if test="status!=null">and status = #{status}</if>
        </where>
        order by group_id desc
    </select>

</mapper>

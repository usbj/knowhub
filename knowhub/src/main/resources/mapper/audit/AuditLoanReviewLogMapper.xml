<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.audit.AuditLoanReviewLogMapper">

    <resultMap id="AuditLoanReviewLogResultMap" type="com.knowhub.pojo.audit.entity.AuditLoanReviewLog">
        <id property="reviewLogId" column="review_log_id"/>
        <result property="loanId" column="loan_id"/>
        <result property="action" column="action"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operator" column="operator"/>
        <result property="role" column="role"/>
        <result property="advice" column="advice"/>
        <result property="createTime" column="create_time"/>
        <result property="operatorNickname" column="nick_name"/>
    </resultMap>

    <!--
      追加一条借出审核流水。
      create_time 由 DB 默认 CURRENT_TIMESTAMP 填充，故 insert 不含该列。
      advice 为可空字段（通过时可选，驳回必填），用 if 动态拼接。
    -->
    <insert id="insertAuditLoanReviewLog" parameterType="com.knowhub.pojo.audit.entity.AuditLoanReviewLog" useGeneratedKeys="true" keyProperty="reviewLogId">
        insert into audit_loan_review_log (loan_id, action, operator_id, operator, role
        <if test="advice != null">, advice</if>)
        values (#{loanId}, #{action}, #{operatorId}, #{operator}, #{role}
        <if test="advice != null">, #{advice}</if>)
    </insert>

    <!--
      按借出ID查审核历史，按动作时间升序还原轨迹（最早→最新）。
      左 join sys_user 带出操作人昵称(nick_name)。
    -->
    <select id="listByLoanId" parameterType="long" resultMap="AuditLoanReviewLogResultMap">
        select r.review_log_id, r.loan_id, r.action, r.operator_id, r.operator,
               r.role, r.advice, r.create_time, u.nick_name
        from audit_loan_review_log r
        left join sys_user u on r.operator_id = u.user_id
        where r.loan_id = #{loanId}
        order by r.create_time asc, r.review_log_id asc
    </select>

</mapper>
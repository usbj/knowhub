<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.ArticleMapper">

    <!--
      文章主表结果映射。
      含 join 带出的展示字段（非表字段，Article 实体扩展属性）：
      - authorNickname：join sys_user on user_id=author_id，LEFT JOIN 防止用户被删时丢行
      - canView/canEdit/isAuthor：详情接口在 service 层回填，不由 SQL 带（列表不回填）
    -->
    <resultMap id="ArticleResultMap" type="com.knowhub.pojo.entity.Article">
        <id property="articleId" column="article_id"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="level" column="level"/>
        <result property="visibility" column="visibility"/>
        <result property="authorId" column="author_id"/>
        <result property="coverObjectKey" column="cover_object_key"/>
        <result property="status" column="status"/>
        <result property="reviewStatus" column="review_status"/>
        <result property="publishTime" column="publish_time"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
        <!-- join 带出的展示字段（非表字段） -->
        <result property="authorNickname" column="author_nickname"/>
    </resultMap>

    <!--
      列表查询：文章主表不存正文（正文在 chapter），summary 前言可预览故列表带出。
      join sys_user(作者昵称)。
      权限过滤（service 层透传 userViewLevel/userId，文章无成员表轻量模型）：
        level <= userViewLevel OR author_id = userId（作者始终能看自己的文章，不看等级）
      无系统查看权限者 userViewLevel=0，level<=0 永假，只走 author_id=userId 分支 → 只看自己写的。
      支持按 title 模糊、level、visibility、status、reviewStatus、createBy、authorId、时间区间过滤。
      按 publish_time desc, article_id desc 排序（与项目/资源列表一致）。
    -->
    <select id="quarryArticle" parameterType="com.knowhub.pojo.quarry.ArticleQuarry" resultMap="ArticleResultMap">
        select a.article_id, a.title, a.summary, a.level, a.visibility,
               a.author_id, a.cover_object_key, a.status, a.review_status, a.publish_time,
               a.create_by, a.create_time, a.update_by, a.update_time, a.deleted,
               u.nick_name as author_nickname
        from article a
                left join sys_user u on a.author_id = u.user_id
        <if test="tagIds != null and tagIds.size() > 0">
            inner join article_tag art on art.article_id = a.article_id
        </if>
        where a.deleted = 0
        <if test="title != null and title != ''">and a.title like concat('%', #{title}, '%')</if>
        <if test="level != null">and a.level = #{level}</if>
        <if test="visibility != null and visibility != ''">and a.visibility = #{visibility}</if>
        <if test="status != null and status != ''">and a.status = #{status}</if>
        <if test="reviewStatus != null and reviewStatus != ''">and a.review_status = #{reviewStatus}</if>
        <if test="createBy != null and createBy != ''">and a.create_by = #{createBy}</if>
        <if test="authorId != null">and a.author_id = #{authorId}</if>
        <if test="beginTime != null">and a.create_time &gt;= #{beginTime}</if>
        <if test="endTime != null">and a.create_time &lt;= #{endTime}</if>
        <if test="tagIds != null and tagIds.size() > 0">
            and art.tag_id in
            <foreach collection="tagIds" item="tid" open="(" separator="," close=")">#{tid}</foreach>
            group by a.article_id
            having count(distinct art.tag_id) = #{tagIds.size()}
        </if>
        and (
            a.level &lt;= #{userViewLevel}
            or a.author_id = #{userId}
        )
        order by a.publish_time desc, a.article_id desc
    </select>

    <!--
      详情：按主键取未删文章，含 summary 前言 + join 带出 authorNickname。
      文章主表无正文（正文在 chapter），详情接口需另调 ChapterMapper 取章节列表。
      权限校验在 service 层（canOp 判定），SQL 不带权限过滤。
    -->
    <select id="getArticleInfoById" parameterType="long" resultMap="ArticleResultMap">
        select a.*, u.nick_name as author_nickname
        from article a
                left join sys_user u on a.author_id = u.user_id
        where a.article_id = #{articleId} and a.deleted = 0
    </select>

    <!-- 新增文章，动态列（对齐 README.dev「Mapper XML insert 均改为动态列」约定） -->
    <insert id="addArticle" parameterType="com.knowhub.pojo.entity.Article" useGeneratedKeys="true" keyProperty="articleId">
        insert into article
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="summary != null">summary,</if>
            <if test="level != null">level,</if>
            <if test="visibility != null">visibility,</if>
            <if test="authorId != null">author_id,</if>
            <if test="coverObjectKey != null">cover_object_key,</if>
            <if test="status != null">status,</if>
            <if test="reviewStatus != null">review_status,</if>
            <if test="publishTime != null">publish_time,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="summary != null">#{summary},</if>
            <if test="level != null">#{level},</if>
            <if test="visibility != null">#{visibility},</if>
            <if test="authorId != null">#{authorId},</if>
            <if test="coverObjectKey != null">#{coverObjectKey},</if>
            <if test="status != null">#{status},</if>
            <if test="reviewStatus != null">#{reviewStatus},</if>
            <if test="publishTime != null">#{publishTime},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <!-- 编辑文章（动态列） -->
    <update id="editArticleInfo" parameterType="com.knowhub.pojo.entity.Article">
        update article
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="level != null">level = #{level},</if>
            <if test="visibility != null and visibility != ''">visibility = #{visibility},</if>
            <if test="authorId != null">author_id = #{authorId},</if>
            <if test="coverObjectKey != null">cover_object_key = #{coverObjectKey},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reviewStatus != null and reviewStatus != ''">review_status = #{reviewStatus},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where article_id = #{articleId}
    </update>

    <update id="softDeleteArticle" parameterType="long">
        update article set deleted = 1, update_time = now() where article_id = #{articleId}
    </update>

    <!-- 对账用：列出所有待审核且未删除的文章 ID，供审核关闭后定时任务批量放行 -->
    <select id="listPendingReviewIds" resultType="java.lang.Long">
        select article_id from article where status = 'PENDING_REVIEW' and deleted = 0
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.article.ChapterMapper">

    <!--
      章节表结果映射。
      含 join 带出的展示与权限字段（非表字段，Chapter 实体扩展属性）：
      - authorNickname：join sys_user on user_id=author_id
      - articleTitle/articleVisibility/articleLevel/articleAuthorId：join article on article_id
      - canEdit/canReview：详情接口在 service 层回填，不由 SQL 带（列表不回填）
    -->
    <resultMap id="ChapterResultMap" type="com.knowhub.pojo.article.entity.Chapter">
        <id property="chapterId" column="chapter_id"/>
        <result property="articleId" column="article_id"/>
        <result property="chapterName" column="chapter_name"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="authorId" column="author_id"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="reviewStatus" column="review_status"/>
        <result property="publishTime" column="publish_time"/>
        <result property="viewCount" column="view_count"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
        <!-- join 带出的展示字段（非表字段） -->
        <result property="authorNickname" column="author_nickname"/>
        <result property="articleTitle" column="article_title"/>
        <result property="articleVisibility" column="article_visibility"/>
        <result property="articleLevel" column="article_level"/>
        <result property="articleAuthorId" column="article_author_id"/>
    </resultMap>

    <!--
      列表查询：不带 content 大字段（避免拖列表），详情接口单独查。
      join sys_user(章节作者昵称) + article(所属文章信息：title/visibility/level/author_id)。
      权限过滤（service 层透传 userViewLevel/userId/articleAuthorId，章节可见性=文章可见性）：
        - 能看文章(level<=userViewLevel OR article_author_id=userId) 即可看其 PUBLISHED 章节
        - 非 PUBLISHED 章节(DRAFT/PENDING_AUTHOR_REVIEW/REJECTED/REVOKED) 仅章节作者 OR 文章作者可见：
            chapter.author_id=userId OR article_author_id=userId
        service 层会先把 articleAuthorId 回填（取所属文章作者），SQL 据此判定非 PUBLISHED 可见性。
      支持按 articleId(必传)、chapterName 模糊、status、reviewStatus、authorId、时间区间过滤。
      按 sort_order asc, chapter_id asc 排序（章节文档顺序）。
    -->
    <select id="quarryChapter" parameterType="com.knowhub.pojo.article.quarry.ChapterQuarry" resultMap="ChapterResultMap">
        select c.chapter_id, c.article_id, c.chapter_name, c.sort_order, c.author_id,
               c.status, c.review_status, c.publish_time, c.view_count,
               c.create_by, c.create_time, c.update_by, c.update_time, c.deleted,
               u.nick_name as author_nickname,
               a.title as article_title, a.visibility as article_visibility,
               a.level as article_level, a.author_id as article_author_id
        from chapter c
                left join sys_user u on c.author_id = u.user_id
                left join article a on c.article_id = a.article_id
        where c.deleted = 0
        <if test="articleId != null">and c.article_id = #{articleId}</if>
        <if test="chapterName != null and chapterName != ''">and c.chapter_name like concat('%', #{chapterName}, '%')</if>
        <if test="status != null and status != ''">and c.status = #{status}</if>
        <if test="reviewStatus != null and reviewStatus != ''">and c.review_status = #{reviewStatus}</if>
        <if test="authorId != null">and c.author_id = #{authorId}</if>
        <if test="beginTime != null">and c.create_time &gt;= #{beginTime}</if>
        <if test="endTime != null">and c.create_time &lt;= #{endTime}</if>
        and (
            <!-- 能看所属文章即可看其 PUBLISHED 章节 -->
            (c.status = 'PUBLISHED'
                and (a.level &lt;= #{userViewLevel} or a.author_id = #{userId})
            )
            <!-- 非 PUBLISHED 章节：仅章节作者 OR 文章作者可见 -->
            or (c.status &lt;&gt; 'PUBLISHED'
                and (c.author_id = #{userId} or a.author_id = #{userId})
            )
        )
        order by c.sort_order asc, c.chapter_id asc
    </select>

    <!--
      详情：按主键取未删章节，含 content 大字段 + join article/sys_user 带出展示与权限字段。
      权限校验在 service 层（章节可见性判定），SQL 不带权限过滤。
    -->
    <select id="getChapterInfoById" parameterType="long" resultMap="ChapterResultMap">
        select c.*, u.nick_name as author_nickname,
               a.title as article_title, a.visibility as article_visibility,
               a.level as article_level, a.author_id as article_author_id
        from chapter c
                left join sys_user u on c.author_id = u.user_id
                left join article a on c.article_id = a.article_id
        where c.chapter_id = #{chapterId} and c.deleted = 0
    </select>

    <!-- 新增章节，动态列（对齐 README.dev「Mapper XML insert 均改为动态列」约定） -->
    <insert id="addChapter" parameterType="com.knowhub.pojo.article.entity.Chapter" useGeneratedKeys="true" keyProperty="chapterId">
        insert into chapter
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="articleId != null">article_id,</if>
            <if test="chapterName != null">chapter_name,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="authorId != null">author_id,</if>
            <if test="content != null">content,</if>
            <if test="status != null">status,</if>
            <if test="reviewStatus != null">review_status,</if>
            <if test="publishTime != null">publish_time,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="articleId != null">#{articleId},</if>
            <if test="chapterName != null">#{chapterName},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="authorId != null">#{authorId},</if>
            <if test="content != null">#{content},</if>
            <if test="status != null">#{status},</if>
            <if test="reviewStatus != null">#{reviewStatus},</if>
            <if test="publishTime != null">#{publishTime},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <!-- 编辑章节（动态列） -->
    <update id="editChapterInfo" parameterType="com.knowhub.pojo.article.entity.Chapter">
        update chapter
        <set>
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="chapterName != null and chapterName != ''">chapter_name = #{chapterName},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="authorId != null">author_id = #{authorId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reviewStatus != null and reviewStatus != ''">review_status = #{reviewStatus},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where chapter_id = #{chapterId}
    </update>

    <update id="softDeleteChapter" parameterType="long">
        update chapter set deleted = 1, update_time = now() where chapter_id = #{chapterId}
    </update>

    <!-- 软删某文章下所有章节（删文章时事务内级联调用） -->
    <update id="softDeleteByArticleId" parameterType="long">
        update chapter set deleted = 1, update_time = now() where article_id = #{articleId} and deleted = 0
    </update>

</mapper>
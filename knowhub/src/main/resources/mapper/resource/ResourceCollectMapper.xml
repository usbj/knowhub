<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.resource.ResourceCollectMapper">

    <resultMap id="ResourceCollectResultMap" type="com.knowhub.pojo.resource.entity.ResourceCollect">
        <id property="collectId" column="collect_id"/>
        <result property="resourceId" column="resource_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="addResourceCollect" parameterType="com.knowhub.pojo.resource.entity.ResourceCollect">
        insert ignore into resource_collect(resource_id, user_id) values (#{resourceId}, #{userId})
    </insert>

    <delete id="deleteResourceCollect" parameterType="com.knowhub.pojo.resource.entity.ResourceCollect">
        delete from resource_collect where resource_id = #{resourceId} and user_id = #{userId}
    </delete>

    <select id="getResourceCollect" parameterType="com.knowhub.pojo.resource.entity.ResourceCollect" resultMap="ResourceCollectResultMap">
        select * from resource_collect where resource_id = #{resourceId} and user_id = #{userId}
    </select>

    <!--
      取某用户已收藏的资源ID列表，按收藏时间倒序。
      前台"我的收藏"：service 用此 ID 列表去取前台可见资源 VO（portal 铁律 status=PUBLISHED AND deleted=0），
      未发布/已删资源自然在 portal SQL 被过滤（收藏事实表保留记录，不影响作者后台可见性，口径同文章 listMyCollected）。
    -->
    <select id="listCollectedResourceIds" resultType="java.lang.Long">
        select resource_id from resource_collect where user_id = #{userId} order by create_time desc
    </select>

</mapper>

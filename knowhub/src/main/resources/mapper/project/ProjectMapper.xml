<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.project.ProjectMapper">

    <!--
      项目主表结果映射。
      含 join 带出的展示字段（非表字段，Project 实体扩展属性）：
      - authorNickname：join sys_user on user_id=author_id，LEFT JOIN 防止用户被删时丢行
      - canView/canDownload/canEdit/myMemberRole：详情接口在 service 层回填，不由 SQL 带（列表不回填）
    -->
    <resultMap id="ProjectResultMap" type="com.knowhub.pojo.project.entity.Project">
        <id property="projectId" column="project_id"/>
        <result property="title" column="title"/>
        <result property="type" column="type"/>
        <result property="level" column="level"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="articleId" column="article_id"/>
        <result property="authorId" column="author_id"/>
        <result property="status" column="status"/>
        <result property="reviewStatus" column="review_status"/>
        <result property="publishTime" column="publish_time"/>
        <!-- 计数列（2026-08-03 补建，见 sql/knowhub-project-portal.sql）-->
        <result property="viewCount" column="view_count"/>
        <result property="likeCount" column="like_count"/>
        <result property="collectCount" column="collect_count"/>
        <result property="downloadCount" column="download_count"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="deleted" column="deleted"/>
        <!-- join 带出的展示字段（非表字段） -->
        <result property="authorNickname" column="author_nickname"/>
    </resultMap>

    <!--
      列表查询：不带 description（大字段，详情接口单独查），避免拖列表。
      join sys_user(负责人昵称)。
      权限过滤（service 层透传 userViewLevel/userId）：
        level <= userViewLevel OR project_id IN (member 子查询 where user_id=? and can_view=1)
      无系统查看权限者 userViewLevel=0，level<=0 永假，只走 member 分支 → 只看参与的项目。
      支持按 title 模糊、type、level、status、reviewStatus、createBy、时间区间过滤。
      按 publish_time desc, project_id desc 排序（与资源列表一致）。
    -->
    <select id="quarryProject" parameterType="com.knowhub.pojo.project.quarry.ProjectQuarry" resultMap="ProjectResultMap">
        select p.project_id, p.title, p.type, p.level, p.summary,
               p.article_id, p.author_id, p.status, p.review_status, p.publish_time,
               p.view_count, p.like_count, p.collect_count, p.download_count,
               p.create_by, p.create_time, p.update_by, p.update_time, p.deleted,
               u.nick_name as author_nickname
        from project p
                left join sys_user u on p.author_id = u.user_id
        where p.deleted = 0
        <if test="title != null and title != ''">and p.title like concat('%', #{title}, '%')</if>
        <if test="type != null and type != ''">and p.type = #{type}</if>
        <if test="level != null">and p.level = #{level}</if>
        <if test="status != null and status != ''">and p.status = #{status}</if>
        <if test="reviewStatus != null and reviewStatus != ''">and p.review_status = #{reviewStatus}</if>
        <if test="createBy != null and createBy != ''">and p.create_by = #{createBy}</if>
        <if test="beginTime != null">and p.create_time &gt;= #{beginTime}</if>
        <if test="endTime != null">and p.create_time &lt;= #{endTime}</if>
        and (
            p.level &lt;= #{userViewLevel}
            or p.project_id in (
                select pm.project_id from project_member pm
                where pm.user_id = #{userId} and pm.can_view = 1 and pm.deleted = 0
            )
        )
        order by p.publish_time desc, p.project_id desc
    </select>

    <!--
      详情：按主键取未删项目，含 description 大字段 + join 带出 authorNickname。
      与列表共用 ProjectResultMap。权限校验在 service 层（canOp 判定），SQL 不带权限过滤。
    -->
    <select id="getProjectInfoById" parameterType="long" resultMap="ProjectResultMap">
        select p.*, u.nick_name as author_nickname
        from project p
                left join sys_user u on p.author_id = u.user_id
        where p.project_id = #{projectId} and p.deleted = 0
    </select>

    <!--
      按 userId 查其可查看的项目 ID 集合（member.can_view=1 的项目）。
      用于无系统查看权限者的列表兜底，以及"我参与的项目"。
    -->
    <select id="listViewableProjectIdsByUser" parameterType="long" resultType="java.lang.Long">
        select project_id from project_member
        where user_id = #{userId} and can_view = 1 and deleted = 0
    </select>

    <!-- 新增项目，动态列（对齐 README.dev「Mapper XML insert 均改为动态列」约定） -->
    <insert id="addProject" parameterType="com.knowhub.pojo.project.entity.Project" useGeneratedKeys="true" keyProperty="projectId">
        insert into project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="type != null">type,</if>
            <if test="level != null">level,</if>
            <if test="summary != null">summary,</if>
            <if test="description != null">description,</if>
            <if test="articleId != null">article_id,</if>
            <if test="authorId != null">author_id,</if>
            <if test="status != null">status,</if>
            <if test="reviewStatus != null">review_status,</if>
            <if test="publishTime != null">publish_time,</if>
            create_by, create_time, update_by, update_time
        </trim>
        values
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="type != null">#{type},</if>
            <if test="level != null">#{level},</if>
            <if test="summary != null">#{summary},</if>
            <if test="description != null">#{description},</if>
            <if test="articleId != null">#{articleId},</if>
            <if test="authorId != null">#{authorId},</if>
            <if test="status != null">#{status},</if>
            <if test="reviewStatus != null">#{reviewStatus},</if>
            <if test="publishTime != null">#{publishTime},</if>
            #{createBy}, now(), #{updateBy}, now()
        </trim>
    </insert>

    <!-- 编辑项目（动态列） -->
    <update id="editProjectInfo" parameterType="com.knowhub.pojo.project.entity.Project">
        update project
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="level != null">level = #{level},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="description != null">description = #{description},</if>
            <if test="articleId != null">article_id = #{articleId},</if>
            <if test="authorId != null">author_id = #{authorId},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reviewStatus != null and reviewStatus != ''">review_status = #{reviewStatus},</if>
            <if test="publishTime != null">publish_time = #{publishTime},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            update_by = #{updateBy},
            update_time = now()
        </set>
        where project_id = #{projectId}
    </update>

    <update id="softDeleteProject" parameterType="long">
        update project set deleted = 1, update_time = now() where project_id = #{projectId}
    </update>

    <!-- 对账用：列出所有待审核且未删除的项目 ID，供审核关闭后定时任务批量放行 -->
    <select id="listPendingReviewIds" resultType="java.lang.Long">
        select project_id from project where status = 'PENDING_REVIEW' and deleted = 0
    </select>

    <!--
      下载计数 +1（下载接口成功后回写，推荐打分权重最高 + 卡片展示下载量）。
      与博客 incrLikeCount/incrCollectCount 同套路：set download_count = download_count + #{delta}。
      delta 通常 +1；预留参数便于后续追溯/撤销计数（如系统判定误触发回退 -1）。
    -->
    <update id="incrDownloadCount">
        update project set download_count = download_count + #{delta} where project_id = #{projectId}
    </update>

    <!-- 点赞计数 +delta（预留，项目尚无点赞接口；后续互动模块给前台时复用，对齐 blog incrLikeCount） -->
    <update id="incrLikeCount">
        update project set like_count = like_count + #{delta} where project_id = #{projectId}
    </update>

    <!-- 收藏计数 +delta（预留，项目尚无收藏接口；后续互动模块给前台时复用，对齐 blog incrCollectCount） -->
    <update id="incrCollectCount">
        update project set collect_count = collect_count + #{delta} where project_id = #{projectId}
    </update>

</mapper>

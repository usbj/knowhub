<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.common.NoticePortalMapper">

    <resultMap id="SysNoticeResultMap" type="com.rookie.common.pojo.entity.SysNotice">
        <id property="noticeId" column="notice_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="noticeType" column="notice_type"/>
        <result property="level" column="level"/>
        <result property="publishScope" column="publish_scope"/>
        <result property="status" column="status"/>
        <result property="isTop" column="is_top"/>
        <result property="needConfirm" column="need_confirm"/>
        <result property="publishTime" column="publish_time"/>
        <result property="expireTime" column="expire_time"/>
        <result property="routePath" column="route_path"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delete" column="delete"/>
    </resultMap>

    <!-- 前台公开公告列表：仅群发（publish_scope='ALL'）+ 已发布 + 未删，置顶优先+发布时间倒序 -->
    <select id="listPublicNotices" resultMap="SysNoticeResultMap">
        select * from sys_notice
        where `delete` = 0
          and status = 'PUBLISHED'
          and publish_scope = 'ALL'
          <if test="noticeType != null and noticeType != ''">and notice_type = #{noticeType}</if>
        order by is_top desc, publish_time desc, notice_id desc
    </select>

    <!-- 前台公开公告单条：同 where 条件 + notice_id，未命中返 null（controller 转 404） -->
    <select id="getPublicNoticeById" resultMap="SysNoticeResultMap">
        select * from sys_notice
        where `delete` = 0
          and status = 'PUBLISHED'
          and publish_scope = 'ALL'
          and notice_id = #{noticeId}
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowhub.mapper.user.AuthoringUserMapper">

    <!--
      前台选人轻型 VO 结果映射：仅列 userId/nickName/username/avatar/phoneNumber/createTime
      （与后台 SysUserVo 区别：不输出 role/sex/status/email/loginIp 等敏感字段，service/mapper 维度内限定）。
    -->
    <resultMap id="AuthoringUserVoMap" type="com.knowhub.pojo.user.vo.AuthoringUserVo">
        <id property="userId" column="user_id"/>
        <result property="nickName" column="nick_name"/>
        <result property="username" column="username"/>
        <result property="avatar" column="avatar"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!--
      前台选人模糊查询：强制 delete=0 AND status=1 过滤有效用户；
      nickName/username/phoneNumber 任一非空按该字段 LIKE 复合 AND，皆空走"最近注册兜底"（分页由 PageHelper 接管）。
      排序 create_time desc 兜底（最近注册优先，与后台 SysUserMapper.quarryUser 一致）。
    -->
    <select id="searchAuthoringUsers" parameterType="com.knowhub.pojo.user.quarry.AuthoringUserSearchQuarry"
            resultMap="AuthoringUserVoMap">
        select user_id, nick_name, username, avatar, phone_number, create_time
        from sys_user
        where `delete` = 0 and status = 1
        <if test="nickName != null and nickName != ''">
            and nick_name like concat('%', #{nickName}, '%')
        </if>
        <if test="username != null and username != ''">
            and username like concat('%', #{username}, '%')
        </if>
        <if test="phoneNumber != null and phoneNumber != ''">
            and phone_number like concat('%', #{phoneNumber}, '%')
        </if>
        order by create_time desc, user_id desc
    </select>

</mapper>